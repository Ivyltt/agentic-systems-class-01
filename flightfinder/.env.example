# Copy to .env and fill in. .env is read by main_advanced.py via load_dotenv().

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Browserbase runs the headless browser that renders Kayak.
BROWSERBASE_API_KEY=bb_...
# REQUIRED in practice. tools.py treats it as optional and calls
# bb.sessions.create() without it, but the Browserbase API rejects a session
# that names no project. Find it in the Browserbase dashboard under Settings.
BROWSERBASE_PROJECT_ID=
